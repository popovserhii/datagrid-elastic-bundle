{
    "name": "pov/datagrid-elastic-bundle",
    "description": "Extension for ZfcDatagrid to support ElasticSearch",
    "keywords": [],
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Serhii Popov",
            "email": "popow.serhii@gmail.com"
        }
    ],
    "require": {
        "php": ">=7.4",
        "jolicode/elastically": "^1.4",
        "symfony/framework-bundle": "^4.4 || ^5.4 || ^6.0 || ^7.0 || ^8.0",
        "zfc-datagrid/zfc-datagrid": "dev-symfony-v0.4.4"
    },
    "require-dev": {
        "symfony/phpunit-bridge": "^3.3"
    },
    "autoload": {
        "psr-4": {
            "Pov\\DatagridElasticBundle\\": "src/"
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
